# VM template: use the existing approved Redis service; no server is installed here.
# Select with --settings <protected-office-settings.json> --env-file <private-vm.env>.
# Copy this file for the VM; application dotenv files are not merged automatically.
# Add approved LLM settings using section 2 of .env.example as the reference.
# Set the full chat-completions endpoint, exact model ID, allowed host and mode;
# inject NL2SQL_MODEL_KEY into the process. The office JSON leaves inference disabled.
# Public hosted_http is synthetic-only; restricted office data needs approved private_http.
# Oracle query/discovery variables in .env.example sections 4/5 must be injected into
# the PROCESS ENVIRONMENT, not added to this dotenv file. See docs/OPERATIONS.md.
# Inject NL2SQL_REDIS_URL through approved process-environment secret management.
# Same VM: redis://<acl-user>:<password>@127.0.0.1:6379/0
# Separate private host: rediss://<acl-user>:<password>@<approved-host>:6379/0
NL2SQL_RATE_LIMIT_BACKEND=redis
NL2SQL_REDIS_KEY_PREFIX=ews:nl2sql:vm
NL2SQL_API_WORKERS=2
NL2SQL_HTTP_CONCURRENCY_LIMIT=64
NL2SQL_REDIS_TIMEOUT_SECONDS=0.5
NL2SQL_REDIS_MAX_CONNECTIONS=16
# Shared chat limits; provisional until measured on the VM/model/database.
NL2SQL_REQUESTS_PER_MINUTE=60
NL2SQL_MAX_CONCURRENT_CHATS=8
NL2SQL_MAX_CONCURRENT_CHATS_PER_PRINCIPAL=1
NL2SQL_ADMISSION_LEASE_SECONDS=300
# For a private CA, inject NL2SQL_REDIS_CA_BUNDLE=<approved-CA-file> with rediss://.
