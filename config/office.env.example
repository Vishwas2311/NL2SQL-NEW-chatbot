# OFFICE ENVIRONMENT - copy outside the repository; keep the populated file private.
# Select this file explicitly with --env-file. Do not use the synthetic .env unchanged.
# Settings paths belong in your private copy of office.example.json.

# 1. APPLICATION / TWENTY USERS
# Eight overall turns share one inference slot during initial qualification.
# Twenty registered users does not mean twenty simultaneous generations.
NL2SQL_DATA_CLASSIFICATION=restricted
NL2SQL_QUERY_BACKEND=oracle
NL2SQL_API_WORKERS=1
NL2SQL_RATE_LIMIT_BACKEND=memory
NL2SQL_MAX_CONCURRENT_CHATS=8
NL2SQL_MAX_CONCURRENT_INFERENCES=1
NL2SQL_MAX_CONCURRENT_CHATS_PER_PRINCIPAL=1
NL2SQL_REQUEST_TIMEOUT_SECONDS=120

# 2. APPROVED SLM ENDPOINT AND ITS TOKEN COUNTER
# No weights are downloaded; both endpoints must already exist and be approved.
NL2SQL_MODEL_MODE=private_http
NL2SQL_MODEL_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
NL2SQL_APPROVED_MODEL_HOSTS='["127.0.0.1"]'
NL2SQL_MODEL_TOKEN_COUNT_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions/input_tokens
# NL2SQL_MODEL_NAME=<exact-runtime-model-id>
# NL2SQL_MODEL_KEY=<inject-through-secret-management>
# Deployment target: verify the selected runtime provides 100000 tokens per request.
NL2SQL_MODEL_CONTEXT_TOKENS=100000
NL2SQL_MODEL_MAX_TOKENS=1200
NL2SQL_MODEL_TIMEOUT_SECONDS=60

# 3. EMBEDDINGS - disabled baseline; enable only after paired evaluation.
NL2SQL_EMBEDDING_MODE=disabled
# NL2SQL_EMBEDDING_MODE=private_http
# NL2SQL_EMBEDDING_ENDPOINT=http://127.0.0.1:8081/v1/embeddings
# NL2SQL_APPROVED_EMBEDDING_HOSTS='["127.0.0.1"]'
# NL2SQL_EMBEDDING_MODEL=<exact-encoder-id>
# NL2SQL_EMBEDDING_VERSION=<immutable-encoder-revision>
# NL2SQL_EMBEDDING_DIMENSION=768
NL2SQL_RETRIEVAL_MAX_TEXT_BYTES=10000000
NL2SQL_RETRIEVAL_MAX_NATIVE_MB=1024

# 4. ORACLE BUSINESS QUERY ACCOUNT - separate from discovery.
# These remain false until the named approvals and DBA checks have actually happened.
NL2SQL_QUERY_APPROVED_ENVIRONMENT=false
NL2SQL_QUERY_OWNER_AUTHORIZED=false
NL2SQL_QUERY_NETWORK_AUTHORIZED=false
NL2SQL_QUERY_READONLY_GRANTS_VERIFIED=false
NL2SQL_QUERY_CONTEXT_PROCEDURES_VERIFIED=false
# NL2SQL_QUERY_DSN=<approved-dsn>
# NL2SQL_QUERY_USER=<read-only-query-account>
# NL2SQL_QUERY_PASSWORD=<inject-secret>
# NL2SQL_QUERY_APPLY_PROCEDURE=<DBA-approved-owner.package.apply>
# NL2SQL_QUERY_RESET_PROCEDURE=<DBA-approved-owner.package.reset>
NL2SQL_QUERY_POOL_MAX=2
NL2SQL_QUERY_TIMEOUT_MS=3000
NL2SQL_QUERY_MAX_RESULT_BYTES=1000000

# 5. ORACLE DICTIONARY DISCOVERY ACCOUNT
NL2SQL_DISCOVERY_APPROVED_ENVIRONMENT=false
NL2SQL_DISCOVERY_OWNER_AUTHORIZED=false
NL2SQL_DISCOVERY_NETWORK_AUTHORIZED=false
# NL2SQL_DISCOVERY_DSN=<approved-dsn>
# NL2SQL_DISCOVERY_USER=<dictionary-account>
# NL2SQL_DISCOVERY_PASSWORD=<inject-secret>
# NL2SQL_DISCOVERY_OWNERS='["APPROVED_OWNER"]'

# 6. CERTIFICATION / AUTHENTICATION
# Configure actual server-owned principals and token hashes or corporate auth integration.
# Reviewer references and keys come from approved secret management; never fabricate approval.
# NL2SQL_METADATA_ADMIN_KEY=<inject-secret>
# NL2SQL_METADATA_ADMIN_TOKEN=<approved-admin-token>
# NL2SQL_METADATA_REVIEWERS=<configured-reviewer-reference-json>

# 7. MULTIWORKER VM - use the VM supervisor, not the one-worker office launcher.
# NL2SQL_RATE_LIMIT_BACKEND=redis
# NL2SQL_API_WORKERS=2
# NL2SQL_REDIS_URL=<approved-redis-url>
