# APPLICATION ENVIRONMENT REFERENCE - SAFE SYNTHETIC DEFAULTS
# python setup_env.py copies this template to .env without replacing an existing file.
# Select .env explicitly with --env-file .env when serving the application.
# Priority: process environment > selected .env file > JSON settings > defaults.
# Replace example.invalid hosts and placeholders before enabling a provider.
# Inject real secrets through approved process-environment secret management.
# Never commit a populated .env. LLM_KEY/LLM_URL/BM_DB_* are not supported aliases.
# Oracle/trust variables may use the same explicitly selected private environment file.

# 1. APPLICATION DATA AND STORAGE
# Local demo: fictional data, SQLite, and credentials created by init-demo.
# Office: use config/office.example.json and a private copy of config/office.env.example.
# This development file overrides JSON with synthetic/SQLite; do not select it unchanged
# for office Oracle. Restricted storage must be outside cloud-synchronized folders.
NL2SQL_DATA_CLASSIFICATION=synthetic
NL2SQL_QUERY_BACKEND=sqlite
# NL2SQL_DATA_DIR=/approved/local/runtime
# NL2SQL_METADATA_ROOT=/approved/local/metadata
NL2SQL_REQUEST_TIMEOUT_SECONDS=15
NL2SQL_QUERY_TIMEOUT_SECONDS=3
NL2SQL_MAX_ROWS=1000
NL2SQL_MAX_RESULT_BYTES=1000000
NL2SQL_SESSION_RETENTION_DAYS=30
NL2SQL_MAX_SESSION_BYTES=4000000

# 2. LLM API
# No inference request is made while disabled. No weights are downloaded.
# Private approved API: set private_http, endpoint, exact model ID and allowed host.
# Public API with synthetic data: hosted_http also requires actual egress approval
# and NL2SQL_PUBLIC_MODEL_AUTHORIZED=true. Restricted data cannot use hosted_http.
# API contract: OpenAI-compatible chat completions with structured JSON plans.
# Endpoint is the FULL chat-completions URL, not just a base URL ending in /v1.
NL2SQL_MODEL_MODE=disabled
# Flexible local/Azure/compatible setup: MODEL_MODE=configured_http (docs/LLM_PROVIDERS.md).
# NL2SQL_MODEL_API=chat_completions
# NL2SQL_MODEL_NETWORK=private
# NL2SQL_MODEL_AUTH=bearer
# NL2SQL_MODEL_RESTRICTED_DATA_AUTHORIZED=false
# NL2SQL_MODEL_TOKEN_BUDGET=provider
# NL2SQL_MODEL_TOKEN_PARAMETER=max_completion_tokens
# NL2SQL_MODEL_TEMPERATURE=null
# NL2SQL_MODEL_REASONING_EFFORT=low
# NL2SQL_MODEL_API_VERSION=2024-10-21
# NL2SQL_MODEL_RESPONSE_IDS='["verified-returned-model-id"]'
# NL2SQL_MODEL_ENDPOINT=https://llm.example.invalid/v1/chat/completions
# NL2SQL_MODEL_NAME=<exact-provider-model-id>
# NL2SQL_APPROVED_MODEL_HOSTS='["llm.example.invalid"]'
# Inject the API key into the application process (Bearer auth).
# NL2SQL_MODEL_KEY=<secret-manager-api-key>
# NL2SQL_MODEL_CA_BUNDLE=/approved/certificates/model-ca.pem
NL2SQL_PUBLIC_MODEL_AUTHORIZED=false
NL2SQL_MODEL_TIMEOUT_SECONDS=8
NL2SQL_MODEL_RETRIES=0
NL2SQL_MODEL_MAX_TOKENS=1200
NL2SQL_MODEL_OUTPUT_MODE=json_schema
NL2SQL_MODEL_CONTEXT_BYTES=64000
# Match the ACTUAL per-request context configured in your model runtime.
NL2SQL_MODEL_CONTEXT_TOKENS=8192
NL2SQL_MODEL_TOKEN_SAFETY_MARGIN=128
# Required for legacy restricted private_http or configured_http with TOKEN_BUDGET=runtime.
# Full chat body -> {"input_tokens": <integer>}, including runtime chat-template tokens.
# NL2SQL_MODEL_TOKEN_COUNT_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions/input_tokens
# If the provider lacks json_schema, use its supported json_object or text_json mode.
# Output is PlanningDecision {"outcome": <QueryPlan or typed clarification>}.
# Direct QueryPlan responses remain readable for existing adapters. Raw SQL fallback is disabled.

# 3. REDIS AND CONCURRENT API WORKERS
# Memory is single-process development only. For concurrent VM workers, use redis.
# Install requirements.txt before selecting the Redis adapter.
NL2SQL_RATE_LIMIT_BACKEND=memory
NL2SQL_API_WORKERS=1
NL2SQL_HTTP_CONCURRENCY_LIMIT=64
# Inject NL2SQL_REDIS_URL into the application process when using redis.
# Same VM example:
# NL2SQL_REDIS_URL=redis://<acl-user>:<percent-encoded-password>@127.0.0.1:6379/0
# Private remote host: use rediss:// and the approved host instead of loopback.
NL2SQL_REDIS_KEY_PREFIX=ews:nl2sql:local
NL2SQL_REDIS_TIMEOUT_SECONDS=0.5
NL2SQL_REDIS_MAX_CONNECTIONS=16
# NL2SQL_REDIS_CA_BUNDLE=/approved/certificates/redis-ca.pem
# Limits are provisional resource budgets, not a simultaneous-user capacity claim.
NL2SQL_REQUESTS_PER_MINUTE=60
NL2SQL_MAX_CONCURRENT_CHATS=8
NL2SQL_MAX_CONCURRENT_INFERENCES=1
NL2SQL_MAX_CONCURRENT_CHATS_PER_PRINCIPAL=1
NL2SQL_ADMISSION_LEASE_SECONDS=300

# 4. ORACLE QUERY ACCOUNT - APPROVED ENVIRONMENT OR EXPLICIT PRIVATE ENV FILE
# The selected --env-file also configures Oracle discovery/query and reviewer trust.
# Actual process environment values take precedence. Keep credentials out of Git.
# Install requirements.txt. Select query_backend=oracle in approved office
# settings, supply reviewed metadata/identity, then inject the following variables
# through the approved launcher or secret manager. No connection is authorized here.
# Approval flags record approvals already obtained; they do not create DB rights.
# NL2SQL_QUERY_APPROVED_ENVIRONMENT=false
# NL2SQL_QUERY_OWNER_AUTHORIZED=false
# NL2SQL_QUERY_NETWORK_AUTHORIZED=false
# NL2SQL_QUERY_READONLY_GRANTS_VERIFIED=false
# NL2SQL_QUERY_CONTEXT_PROCEDURES_VERIFIED=false
# NL2SQL_QUERY_DSN=db.example.invalid:1521/APP_SERVICE
# NL2SQL_QUERY_USER=<approved-readonly-query-user>
# NL2SQL_QUERY_PASSWORD=<secret-manager-value>
# DBA-approved context routines bind/reset authenticated identity on pooled sessions.
# NL2SQL_QUERY_APPLY_PROCEDURE=APP_OWNER.APP_CONTEXT.APPLY_IDENTITY
# NL2SQL_QUERY_RESET_PROCEDURE=APP_OWNER.APP_CONTEXT.RESET_IDENTITY
# NL2SQL_QUERY_POOL_MAX=4
# NL2SQL_QUERY_TIMEOUT_MS=3000
# NL2SQL_QUERY_MAX_RESULT_BYTES=1000000

# 5. ORACLE DICTIONARY DISCOVERY - APPROVED ENVIRONMENT OR PRIVATE ENV FILE
# Separate allowlisted dictionary account; never reuse browser identity or assume
# discovery evidence certifies business metrics/access. Keep commented in this file.
# NL2SQL_DISCOVERY_SOURCE_ID=office-oracle
# NL2SQL_DISCOVERY_APPROVED_ENVIRONMENT=false
# NL2SQL_DISCOVERY_OWNER_AUTHORIZED=false
# NL2SQL_DISCOVERY_NETWORK_AUTHORIZED=false
# NL2SQL_DISCOVERY_DSN=db.example.invalid:1521/APP_SERVICE
# NL2SQL_DISCOVERY_USER=<approved-dictionary-user>
# NL2SQL_DISCOVERY_PASSWORD=<secret-manager-value>
# NL2SQL_DISCOVERY_OWNERS='["APP_OWNER"]'
# NL2SQL_DISCOVERY_TIMEOUT_SECONDS=15
# NL2SQL_DISCOVERY_MAX_ROWS=100000
# NL2SQL_DISCOVERY_MAX_BYTES=20000000

# 6. OPTIONAL EMBEDDINGS
# Lexical retrieval works without an embedding API, model server or downloaded weights.
NL2SQL_EMBEDDING_MODE=disabled
# For an approved private_http embedding adapter, configure compatible model/version,
# dimensions and normalization consistently at metadata staging and runtime.
# NL2SQL_EMBEDDING_ENDPOINT=https://embeddings.example.invalid/v1/embeddings
# NL2SQL_APPROVED_EMBEDDING_HOSTS='["embeddings.example.invalid"]'
# NL2SQL_EMBEDDING_MODEL=<approved-embedding-model-id>
# NL2SQL_EMBEDDING_VERSION=<approved-version>
# NL2SQL_EMBEDDING_DIMENSION=384
# Inject the embedding API key into the application process if required.
# NL2SQL_EMBEDDING_KEY=<secret-manager-api-key>

# 7. RETRIEVAL LIMITS
# Maximum records passed to planning and maximum retrieval candidates.
NL2SQL_RETRIEVAL_TOP_K=10
NL2SQL_RETRIEVAL_MAX_CANDIDATES=20

# Configuration/loading details: docs/CONFIGURATION.md.
# Approved Oracle bootstrap, metadata publication and execution: docs/OPERATIONS.md.
# Authentication/grants remain in protected settings and approved identity adapters;
# never put reusable production tokens in the frozen browser UI.

# Embedded SurrealDB projections need no graph endpoint or DLL-directory setting.

# Retrieval budgets include all authorized schema text and per-partition memory estimates (not a hard RSS cap).
NL2SQL_RETRIEVAL_MAX_TEXT_BYTES=10000000
NL2SQL_RETRIEVAL_MAX_NATIVE_MB=1024
