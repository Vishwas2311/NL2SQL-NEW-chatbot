# Explicitly select this file with --env-file; no parent .env is loaded.
# Environment variables override this file, which overrides JSON settings.
NL2SQL_MODEL_MODE=disabled
NL2SQL_EMBEDDING_MODE=disabled
NL2SQL_DATA_CLASSIFICATION=synthetic
NL2SQL_QUERY_BACKEND=sqlite
NL2SQL_RETRIEVAL_TOP_K=10
NL2SQL_RETRIEVAL_MAX_CANDIDATES=20
NL2SQL_MODEL_OUTPUT_MODE=json_schema
NL2SQL_MODEL_CONTEXT_BYTES=64000
