# LOCAL DEVELOPMENT ENVIRONMENT
# python setup_env.py copies this template to .env without replacing an existing file.
# Select .env explicitly with --env-file .env when serving the application.
# Priority: process environment > selected .env file > JSON settings > defaults.

# 1. DATA AND DATABASE
# Use fictional demo data and SQLite for local development.
NL2SQL_DATA_CLASSIFICATION=synthetic
NL2SQL_QUERY_BACKEND=sqlite

# 2. MODEL AND EMBEDDINGS
# Disabled: no model server, embedding service or weights are needed for the demo.
NL2SQL_MODEL_MODE=disabled
NL2SQL_EMBEDDING_MODE=disabled
NL2SQL_MODEL_OUTPUT_MODE=json_schema
NL2SQL_MODEL_CONTEXT_BYTES=64000

# 3. RETRIEVAL LIMITS
# Maximum records passed to planning and maximum retrieval candidates.
NL2SQL_RETRIEVAL_TOP_K=10
NL2SQL_RETRIEVAL_MAX_CANDIDATES=20

# 4. OFFICE CONFIGURATION
# Use config/office.example.json and the operating runbooks after office approval.
# Real credentials belong in company-approved secret injection, never this template.
