from pathlib import Path

class Database:
    def __init__(
        self,
        database_path: str | Path,
        *,
        buffer_pool_size: int = ...,
        max_num_threads: int = ...,
        read_only: bool = ...,
    ) -> None: ...
    def close(self) -> None: ...

class QueryResult:
    def has_next(self) -> bool: ...
    def get_next(self) -> list[object]: ...
    def close(self) -> None: ...

class Connection:
    def __init__(self, database: Database, num_threads: int = ...) -> None: ...
    def execute(
        self, query: str, parameters: dict[str, object] | None = ...
    ) -> QueryResult | list[QueryResult]: ...
    def close(self) -> None: ...
